load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("//vivado:defs.bzl", "xsim_test")

# Negative test: `$error` in the testbench must translate to a failing
# `xsim_test`. The sh_test wrapper flips the sign so a genuine
# `xsim_test` failure PASSES the wrapper.

verilog_library(
    name = "tb",
    srcs = ["tb.sv"],
)

xsim_test(
    # `manual` because this test is DESIGNED to fail — its whole
    # purpose is to be wrapped by `error_detection_expect_failure_test`,
    # which inverts the exit code. Under a `//...` wildcard it would
    # show as a FAILED test even though the failure is expected;
    # `manual` keeps it out of wildcard discovery while still letting
    # the wrapper consume it as data.
    name = "error_detection_xsim",
    module = ":tb",
    module_top = "error_detection_tb",
    part_number = "xczu28dr-ffvg1517-2-e",
    tags = [
        "manual",
        "requires-vivado",
    ],
)

sh_test(
    name = "error_detection_expect_failure_test",
    srcs = ["//tests:expect_xsim_failure.sh"],
    args = ["$(location :error_detection_xsim)"],
    data = [":error_detection_xsim"],
    tags = ["requires-vivado"],
)
