set PROJECT_DIR {{PROJECT_DIR}}
set PART_NUMBER {{PART_NUMBER}}
set SIM_TOP     {{SIM_TOP}}
set SIMULATOR   {{SIMULATOR}}
set EXPORT_DIR  {{EXPORT_DIR}}

set HDL_SOURCES {{HDL_SOURCES}}
set XDC_FILES   {{XDC_FILES}}
set TCL_FILES   {{TCL_FILES}}

set IP_REPOS                {{IP_REPOS}}
set IP_CONFIGURED_INSTANCES {{IP_CONFIGURED_INSTANCES}}
set IP_INSTANCES            {{IP_INSTANCES}}

set BLOCK_DESIGNS {{BLOCK_DESIGNS}}

set PRE_HOOKS  {{PRE_HOOKS}}
set POST_HOOKS {{POST_HOOKS}}

# `.tcl` pre_hooks run here — before the project exists — for helper procs /
# globals the rest of the template consumes. Executable `pre_hooks` run in
# the enclosing Bazel action before Vivado starts and never see this context.
foreach hook $PRE_HOOKS { source $hook }

# Stage an on-disk project so `export_simulation` has a stable place to trace
# IP runs from. `-in_memory` misses generated sim products for some IP/BD
# combinations.
create_project export_project $PROJECT_DIR -part $PART_NUMBER -force

if {[llength $IP_REPOS] > 0} {
    set_property ip_repo_paths $IP_REPOS [current_project]
    update_ip_catalog
}

foreach ci $IP_CONFIGURED_INSTANCES {
    lassign $ci ci_module_top ci_repo ci_xci_relpath
    set _xci_import_dir [file join \
        [file dirname $PROJECT_DIR] \
        [file tail $PROJECT_DIR]_imported_xcis \
        $ci_module_top]
    file mkdir $_xci_import_dir
    foreach _item [glob -nocomplain -directory $ci_repo *] {
        file copy -force $_item $_xci_import_dir/
    }
    exec chmod -R u+rwX $_xci_import_dir
    add_files -fileset sources_1 [file join $_xci_import_dir $ci_xci_relpath]
}

foreach inst $IP_INSTANCES {
    lassign $inst inst_name inst_vendor inst_library inst_version inst_module_name
    create_ip -name $inst_name -vendor $inst_vendor -library $inst_library \
        -version $inst_version -module_name $inst_module_name
}

foreach bd $BLOCK_DESIGNS {
    lassign $bd bd_module_top bd_dir
    set _bd_import_dir [file join \
        [file dirname $PROJECT_DIR] \
        [file tail $PROJECT_DIR]_imported_bds \
        $bd_module_top]
    file mkdir $_bd_import_dir
    foreach _item [glob -nocomplain -directory $bd_dir *] {
        file copy -force $_item $_bd_import_dir/
    }
    exec chmod -R u+rwX $_bd_import_dir
    add_files -fileset sources_1 [file join $_bd_import_dir ${bd_module_top}.bd]
}

foreach entry $HDL_SOURCES {
    lassign $entry kind path library standard
    switch -- $kind {
        verilog       { read_verilog -library $library $path }
        systemverilog { read_verilog -library $library -sv $path }
        vhdl {
            switch -- $standard {
                2008    { read_vhdl -vhdl2008 -library $library $path }
                2019    { read_vhdl -vhdl2019 -library $library $path }
                default { read_vhdl           -library $library $path }
            }
        }
        import        { import_files $path }
    }
}

foreach f $XDC_FILES { read_xdc $f }
foreach f $TCL_FILES { source $f }

# Without a current compile order, BDs that haven't been generated yet can
# end up missing from the exported source list.
update_compile_order -fileset sources_1

# Upgrade IPs registered with an older catalog before BD `generate_target`
# runs. Without this, BDs whose per-IP versions differ from the current
# catalog (typical after a Vivado version bump) fail with `[BD 41-1664]
# Unable to generate target(s) ... is locked. List of locked IPs: ...`.
# `if [llength]` avoids `get_ips` empty-list complaints.
set _ips [get_ips -quiet]
if {[llength $_ips]} { upgrade_ip -quiet $_ips }

# Skip nested child BDs — Vivado errors with `[Vivado 12-3563]` if you try
# to regenerate one directly (they're owned by their parent).
foreach _bd [get_files -quiet "*.bd"] {
    if {[string match "*/ip/*" $_bd] || [string match "*/bd_*/*" $_bd]} {
        continue
    }
    generate_target simulation $_bd
}

# `export_simulation` refuses to run without a top on the simulation fileset
# (`[exportsim-Tcl-70] A simulation top was not set`).
set_property top $SIM_TOP [current_fileset -simset]

# `-export_source_files` physically copies IP/BD sources into the export
# tree — otherwise compile.do references project-relative paths that go
# stale once the sandbox is gone.
export_simulation \
    -simulator $SIMULATOR \
    -directory $EXPORT_DIR \
    -export_source_files \
    -force

# `-export_source_files` only copies compile_order files (.v/.sv/.vhd), not
# `.vh` Verilog headers. Copy each header into every IP subdir so `include`
# resolves via same-dir search (no `+incdir+` patching of compile.do).
set _vh_files [get_files -filter {FILE_TYPE == "Verilog Header"}]
if {[llength $_vh_files] > 0} {
    foreach _ip_dir [glob -nocomplain -directory $EXPORT_DIR/$SIMULATOR/srcs/ip -type d "*/*"] {
        foreach _vh $_vh_files {
            file copy -force $_vh $_ip_dir/[file tail $_vh]
        }
    }
}

# Per-simulator driver conventions vary — questa/modelsim emit `compile.do`,
# xsim emits `<sim_top>.sh` + `vlog.prj`, xcelium emits `cxl.compile.sh`.
# Just verify SOME `.sh` driver landed under `<EXPORT_DIR>/<SIMULATOR>/`.
set _driver_scripts [glob -nocomplain -type f "$EXPORT_DIR/$SIMULATOR/*.sh"]
if {[llength $_driver_scripts] == 0} {
    error "export_simulation produced no driver `.sh` under\
 $EXPORT_DIR/$SIMULATOR/ — the IP/BD set likely contains no sim\
 sources, or `generate_target simulation` silently skipped them.\
 Check that every ip_block / block_design has simulation products\
 in the project before export."
}

# `.tcl` post_hooks run here — project still open, EXPORT_DIR populated,
# `get_files` / `get_ips` still resolve. Executable `post_hooks` run in the
# enclosing Bazel action after Vivado exits.
foreach hook $POST_HOOKS { source $hook }

close_project
